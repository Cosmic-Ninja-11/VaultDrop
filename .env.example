# Copy this file to `.env` (which is gitignored) and fill in your Firebase project details.
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID

# Optional: paste your Firestore security rules here and run `python scripts/sync_env.py`
# to generate a local gitignored `firestore.rules` file.
FIRESTORE_RULES="""rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Define your VaultDrop share & chunk rules here
  }
}"""
