rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shares/{shareId} {
      // Anyone with the shareId link can read the encrypted metadata,
      // ONLY while the link has not expired.
      allow get: if resource.data.expiresAt > request.time;

      // Owners can list their own created links.
      allow list: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;

      // Authenticated users (Email, Google, or Anonymous Guest) can create links,
      // strictly enforcing a maximum validity of 24 hours (1440 minutes).
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ttlMinutes >= 5
                    && request.resource.data.ttlMinutes <= 1440
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt <= request.time + duration.value(24, 'h')
                    && request.resource.data.ahnuSize > 0
                    && request.resource.data.ahnuSize <= 12582912;

      // Only the link creator can delete/revoke their link.
      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      // Prevent arbitrary updates after creation.
      allow update: if false;

      // Encrypted .ahnu binary chunks stored under each share.
      match /chunks/{chunkId} {
        allow read: if get(/databases/$(database)/documents/shares/$(shareId)).data.expiresAt > request.time;
        allow create: if request.auth != null
                      && getAfter(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid == request.auth.uid;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/shares/$(shareId)).data.ownerUid == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
